# ==========================================
# TALENTAI TYPESCRIPT BACKEND CONFIGURATION
# ==========================================

# Database MySQL Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=talentai_db
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/talentai_db"

# Application Settings
APP_ENV=development
APP_PORT=8000
PORT=8000

# Google Gemini API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
